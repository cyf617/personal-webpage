---
import Layout from "../layouts/Layout.astro";
import { content as c } from "../data/content";
---

<Layout current="/education" title="Education — Yifan Chen" description="Academic background of Yifan Chen — MSc at Imperial College London, BSc at Xi'an Jiaotong-Liverpool University.">
  <section class="page-section">
    <div class="reveal">
      <p class="section-siglum">
        <span class="lang-en">§1 Education</span>
        <span class="lang-zh">§1 教育</span>
      </p>
      <h1 class="section-title">
        <span class="lang-en">{c.education.en.heading}</span>
        <span class="lang-zh">{c.education.zh.heading}</span>
      </h1>
    </div>

    <div class="timeline">
      {c.education.en.items.map((_, i) => {
        const en = c.education.en.items[i];
        const zh = c.education.zh.items[i];
        return (
          <div class="timeline-item reveal">
            <span class="timeline-dot"></span>
            <div class="timeline-line"></div>
            <div class="timeline-header">
              <h2 class="timeline-title">
                <span class="lang-en">{en.school}</span>
                <span class="lang-zh">{zh.school}</span>
              </h2>
              <span class="timeline-date">
                <span class="lang-en">{en.date}</span>
                <span class="lang-zh">{zh.date}</span>
              </span>
            </div>
            <p class="timeline-subtitle">
              <span class="lang-en">{en.degree} — {en.location}</span>
              <span class="lang-zh">{zh.degree} — {zh.location}</span>
            </p>
            <ul class="timeline-details">
              {en.detail.map((_, j) => (
                <li class="timeline-detail-item">
                  <span class="lang-en">{en.detail[j]}</span>
                  <span class="lang-zh">{zh.detail[j]}</span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>
</Layout>