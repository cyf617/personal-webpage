---
import Layout from "../layouts/Layout.astro";
import { content as c } from "../data/content";
const BASE = import.meta.env.BASE_URL;
const cvEN = `${BASE}/cv/Yifan_Chen_CV_EN.pdf`.replace(/\/+/g, "/");
const cvZH = `${BASE}/cv/Yifan_Chen_CV_ZH.pdf`.replace(/\/+/g, "/");
---

<Layout current="/about" title="About — Yifan Chen" description="About Yifan Chen — AI data analyst with expertise in complex mobility systems, trustworthy AI and sports AI.">
  <section class="page-section">
    <div class="reveal">
      <p class="section-siglum">
        <span class="lang-en">§4 About</span>
        <span class="lang-zh">§4 关于</span>
      </p>
      <h1 class="section-title">
        <span class="lang-en">{c.about.en.heading}</span>
        <span class="lang-zh">{c.about.zh.heading}</span>
      </h1>
    </div>

    <div class="reveal">
      {c.about.en.body.map((_, i) => (
        <p class="about-bio">
          <span class="lang-en">{c.about.en.body[i]}</span>
          <span class="lang-zh">{c.about.zh.body[i]}</span>
        </p>
      ))}
    </div>

    <hr style="margin: 2rem 0; border: none; border-top: 1px solid var(--color-rule);" />

    <div class="reveal">
      <h2 style="font-size: 1.4rem; margin-bottom: 1.5rem;">
        <span class="lang-en">{c.skills.en.heading}</span>
        <span class="lang-zh">{c.skills.zh.heading}</span>
      </h2>
      {c.skills.en.groups.map((_, i) => {
        const en = c.skills.en.groups[i];
        const zh = c.skills.zh.groups[i];
        return (
          <div class="skills-group">
            <p class="skills-label">
              <span class="lang-en">{en.label}</span>
              <span class="lang-zh">{zh.label}</span>
            </p>
            <p class="skills-items">
              <span class="lang-en">{en.items.join(" · ")}</span>
              <span class="lang-zh">{zh.items.join(" · ")}</span>
            </p>
          </div>
        );
      })}
    </div>

    <hr style="margin: 2rem 0; border: none; border-top: 1px solid var(--color-rule);" />

    <div class="reveal">
      <h2 style="font-size: 1.4rem; margin-bottom: 0.5rem;">
        <span class="lang-en">{c.contact.en.heading}</span>
        <span class="lang-zh">{c.contact.zh.heading}</span>
      </h2>
      <p class="about-bio" style="margin-bottom: 1rem;">
        <span class="lang-en">{c.contact.en.subheading}</span>
        <span class="lang-zh">{c.contact.zh.subheading}</span>
      </p>

      <div class="contact-links">
        <a href={`mailto:${c.contact.en.email}`} class="contact-link">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          {c.contact.en.email}
        </a>
        <a href={c.contact.en.github} target="_blank" rel="noopener" class="contact-link">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.07 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.6.24 2.77.12 3.07.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
          GitHub
        </a>
        <a href={cvEN} target="_blank" class="contact-link lang-en">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          {c.contact.en.cv}
        </a>
        <a href={cvZH} target="_blank" class="contact-link lang-zh">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          {c.contact.zh.cv}
        </a>
      </div>
    </div>
  </section>
</Layout>