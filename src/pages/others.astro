---
import Layout from "../layouts/Layout.astro";
import { content as c } from "../data/content";
const BASE = import.meta.env.BASE_URL;
const cvEN = `${BASE}/cv/Yifan_Chen_CV_EN.pdf`.replace(/\/+/g, "/");
const cvZH = `${BASE}/cv/Yifan_Chen_CV_ZH.pdf`.replace(/\/+/g, "/");
---

<!--
  想换成真实内容?
  ▸ 观赛照片:在 src/data/content.ts 的 hobbies.liverpoolPhotos 里把空字符串换成图片路径,
    例如 "/matchday1.jpg"(图片放 public/ 下),就会自动显示图片而不是占位框。
  ▸ 专辑:在 hobbies.albums 里填每个对象的 cover / audioSrc / title / artist。
    cover    = 封面图路径,例如 "/covers/album1.jpg"
    audioSrc = 音频路径,例如 "/audio/song1.mp3"(文件放 public/ 下)
    填好后点击封面即可在本页内播放/暂停,同时只会播一首。
-->
<Layout current="/others" title="Others — Yifan Chen" description="Hobbies and interests of Yifan Chen — football, basketball, Liverpool FC, R&B and Soul music.">
  <section class="page-section">
    <div class="reveal">
      <p class="section-siglum">
        <span class="lang-en">§5 Others</span>
        <span class="lang-zh">§5 其他</span>
      </p>
      <h1 class="section-title">
        <span class="lang-en">{c.hobbies.en.pageHeading}</span>
        <span class="lang-zh">{c.hobbies.zh.pageHeading}</span>
      </h1>
    </div>
    <!-- Albums (click record to play) -->
    <div class="reveal">
      <h2 class="hobbies-heading">
        <span class="lang-en">{c.hobbies.en.albumsHeading}</span>
        <span class="lang-zh">{c.hobbies.zh.albumsHeading}</span>
      </h2>
      <p class="about-bio" style="margin-bottom: 1.5rem;">
        <span class="lang-en">{c.hobbies.en.albumsCaption}</span>
        <span class="lang-zh">{c.hobbies.zh.albumsCaption}</span>
      </p>

      <div class="music-player-wrapper">
        <!-- Turntable Deck -->
        <div class="record-player" id="record-player">
          <div class="platter-area">
            <!-- Clicking the vinyl record shuffles/changes track -->
            <div class="vinyl-record" id="vinyl-record" aria-label="Shuffle / Next Track">
              <div class="vinyl-label">
                <img id="current-album-cover" src="" alt="Album cover" />
                <div class="vinyl-center-dot"></div>
              </div>
            </div>
          </div>
          <!-- Tonearm Assembly -->
          <div class="tonearm-assembly" id="tonearm">
            <div class="tonearm-pivot"></div>
            <div class="tonearm-arm"></div>
            <div class="tonearm-headshell"></div>
          </div>

          <!-- Play / Pause Power Switch on the Deck -->
          <button class="deck-power-btn" id="deck-power-btn" aria-label="Toggle Play/Pause">
            <svg class="power-icon-play" id="power-icon-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <svg class="power-icon-pause" id="power-icon-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style="display: none;"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
          </button>
        </div>

        <!-- Meta Section (Spacious layout for song details and subjective descriptions) -->
        <div class="player-info">
          <div class="player-info-header">
            <div class="track-meta">
              <h3 class="track-title" id="track-song">
                <span class="lang-en font-normal">Click Record to Begin a Music Journey</span>
                <span class="lang-zh font-normal">点击唱片进入一段音乐旅途</span>
              </h3>
              <p class="track-artist" id="track-artist"></p>
            </div>
            <!-- Audio playing equalizer bars -->
            <div class="eq-bars" id="eq-bars" style="display: none; margin-top: 6px;">
              <div class="eq-bar"></div>
              <div class="eq-bar"></div>
              <div class="eq-bar"></div>
              <div class="eq-bar"></div>
            </div>
          </div>

          <div class="track-meta-detail">
            <span class="lang-en" id="track-meta-detail-en"></span>
            <span class="lang-zh" id="track-meta-detail-zh"></span>
          </div>

          <!-- Subjective interpretation -->
          <p class="track-desc lang-en" id="track-desc-en">
            Click the vinyl record on the left to get a random music snippet.
          </p>
          <p class="track-desc lang-zh" id="track-desc-zh">
            点击左侧的黑胶唱片，即可收获一段随机音乐片段。
          </p>
        </div>
      </div>

      <!-- JSON data bridge for JavaScript -->
      <div id="album-data" data-albums={JSON.stringify(c.hobbies.albums)} data-base={BASE} style="display: none;"></div>
      <audio id="album-audio" preload="none"></audio>
    </div>

    <hr style="margin: 2rem 0; border: none; border-top: 1px solid var(--color-rule);" />

    <!-- Matchday photos carousel -->
    <div class="reveal">
      <h2 class="hobbies-heading" style="margin-bottom: 1.5rem;">
        <span class="lang-en">{c.hobbies.en.liverpoolHeading}</span>
        <span class="lang-zh">{c.hobbies.zh.liverpoolHeading}</span>
      </h2>
      {
        (() => {
          const photos = c.hobbies.liverpoolPhotos.filter(Boolean);
          if (photos.length === 0) {
            return (
              <div class="gallery gallery--photos">
                <div class="gallery-item gallery-item--photo">
                  <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="9" cy="9" r="2" />
                    <path d="M21 15l-5-5L5 21" />
                  </svg>
                  <span class="lang-en">{c.hobbies.en.photoPlaceholder}</span>
                  <span class="lang-zh">{c.hobbies.zh.photoPlaceholder}</span>
                </div>
              </div>
            );
          }
          return (
            <div class="matchday-carousel" id="matchday-carousel" data-count={photos.length}>
              <div class="matchday-frame">
                <div class="matchday-stage">
                  <div class="matchday-track" id="matchday-track">
                    {photos.length > 1 && (
                      <div class="matchday-slide matchday-slide--clone" aria-hidden="true">
                        <img
                          src={`${BASE}${photos[photos.length - 1]}`.replace(/\/+/g, "/")}
                          alt=""
                          loading="eager"
                          decoding="async"
                          draggable="false"
                        />
                      </div>
                    )}
                    {photos.map((photo, i) => (
                      <div class="matchday-slide">
                        <img
                          src={`${BASE}${photo}`.replace(/\/+/g, "/")}
                          alt={`Matchday ${i + 1}`}
                          loading={i === 0 ? "eager" : "lazy"}
                          decoding="async"
                          draggable="false"
                        />
                      </div>
                    ))}
                    {photos.length > 1 && (
                      <div class="matchday-slide matchday-slide--clone" aria-hidden="true">
                        <img
                          src={`${BASE}${photos[0]}`.replace(/\/+/g, "/")}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          draggable="false"
                        />
                      </div>
                    )}
                  </div>
                </div>
                <button class="matchday-nav matchday-nav--prev" type="button" aria-label="Previous photo" data-dir="-1">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button class="matchday-nav matchday-nav--next" type="button" aria-label="Next photo" data-dir="1">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
              </div>
              <div class="matchday-counter">
                <span id="matchday-current">1</span><span class="matchday-counter-sep"> / </span><span id="matchday-total">{photos.length}</span>
              </div>
            </div>
          );
        })()
      }
    </div>

    <hr style="margin: 2rem 0; border: none; border-top: 1px solid var(--color-rule);" />

    <!-- Contact (moved from home) -->
    <div class="reveal">
      <h2 class="hobbies-heading">
        <span class="lang-en">{c.contact.en.heading}</span>
        <span class="lang-zh">{c.contact.zh.heading}</span>
      </h2>
      <p class="about-bio" style="margin-bottom: 1rem;">
        <span class="lang-en">{c.contact.en.subheading}</span>
        <span class="lang-zh">{c.contact.zh.subheading}</span>
      </p>

      <div class="contact-links">
        <a href={`mailto:${c.contact.en.email}`} class="contact-link">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          {c.contact.en.email}
        </a>
      </div>
    </div>

    <!-- Liverpool FC anthem -->
    <p class="anthem">You'll Never Walk Alone!</p>
  </section>

  <script is:inline>
    (function () {
      const carousel = document.getElementById('matchday-carousel');
      if (!carousel) return;
      const track = document.getElementById('matchday-track');
      const currentEl = document.getElementById('matchday-current');
      const total = parseInt(carousel.dataset.count || '0', 10);
      if (!track || total <= 0) return;

      // Infinite-carousel layout: the track wraps a clone of the last slide
      // before slide 0 and a clone of slide 0 after the last slide. Logical
      // index i (0..total-1) maps to DOM child i+1. Wrapping animates into the
      // clone, then snaps back to the real slide with no transition.
      let index = total > 1 ? 0 : -1;   // -1 = single-photo sentinel (no clones)
      let pos = total > 1 ? 1 : 0;      // DOM child index currently centered
      let busy = false;

      function applyTransform(animate) {
        track.style.transition = animate ? '' : 'none';
        track.style.transform =
          `translateX(calc((100% - var(--slide-w)) / 2 - ${pos} * (var(--slide-w) + var(--slide-gap))))`;
        if (currentEl && index >= 0) currentEl.textContent = String(index + 1);
      }

      function resetIfClone() {
        if (pos === 0) { pos = total; applyTransform(false); }
        else if (pos === total + 1) { pos = 1; applyTransform(false); }
        busy = false;
      }

      function go(dir) {
        if (total <= 1 || busy) return;
        busy = true;
        pos += dir;
        // Derive the logical index for the counter from the new DOM position.
        if (pos === 0) index = total - 1;
        else if (pos === total + 1) index = 0;
        else index = pos - 1;
        applyTransform(true);

        // After the transition ends (or a fallback timer for reduced-motion),
        // snap from the clone back to the corresponding real slide.
        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          clearTimeout(timer);
          track.removeEventListener('transitionend', onEnd);
          resetIfClone();
        };
        const onEnd = (e) => { if (e.propertyName === 'transform') finish(); };
        track.addEventListener('transitionend', onEnd);
        const dur = parseFloat(getComputedStyle(track).transitionDuration) || 0;
        const timer = setTimeout(finish, dur * 1000 + 60);
      }

      carousel.querySelectorAll('.matchday-nav').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = parseInt(btn.dataset.dir || '1', 10);
          go(dir);
        });
      });

      applyTransform(false);
    })();
  </script>

  <script is:inline>
    (function () {
      const audio = document.getElementById('album-audio');
      if (!audio) return;

      // DOM elements
      const vinylRecord = document.getElementById('vinyl-record');
      const vinylCover = document.getElementById('current-album-cover');
      const tonearm = document.getElementById('tonearm');
      const eqBars = document.getElementById('eq-bars');
      
      const deckPowerBtn = document.getElementById('deck-power-btn');
      const powerIconPlay = document.getElementById('power-icon-play');
      const powerIconPause = document.getElementById('power-icon-pause');

      const dataBridge = document.getElementById('album-data');
      if (!dataBridge) return;

      const base = dataBridge.dataset.base || '';
      const rawAlbums = JSON.parse(dataBridge.dataset.albums || '[]');
      const albums = rawAlbums.map(a => ({
        cover: a.cover ? `${base}${a.cover}`.replace(/\/+/g, "/") : "",
        audioSrc: a.audioSrc ? `${base}${a.audioSrc}`.replace(/\/+/g, "/") : "",
        title: a.title || "",
        artist: a.artist || "",
        song: a.song || "",
        year: a.year || "",
        genreEN: a.genreEN || "",
        genreZH: a.genreZH || "",
        descEN: a.descEN || "",
        descZH: a.descZH || ""
      }));

      // State variables
      let currentIndex = -1;
      let isPlaying = false;

      // Set playing UI state
      function updatePlayerUI(playing) {
        isPlaying = playing;
        
        if (playing) {
          vinylRecord.classList.add('is-playing');
          tonearm.classList.add('is-playing');
          eqBars.style.display = 'flex';
          // Add equalizer bar animations
          const bars = eqBars.querySelectorAll('.eq-bar');
          bars.forEach(bar => bar.classList.add('eq-bar-playing'));

          // Toggle deck power button icons
          powerIconPlay.style.display = 'none';
          powerIconPause.style.display = 'block';
        } else {
          vinylRecord.classList.remove('is-playing');
          tonearm.classList.remove('is-playing');
          const bars = eqBars.querySelectorAll('.eq-bar');
          bars.forEach(bar => bar.classList.remove('eq-bar-playing'));

          // Toggle deck power button icons
          powerIconPlay.style.display = 'block';
          powerIconPause.style.display = 'none';

          // Wait briefly for tonearm to lift before hiding equalizer
          setTimeout(() => {
            if (!isPlaying) eqBars.style.display = 'none';
          }, 800);
        }
      }

      // Load and play a track
      function loadTrack(index, forcePlay = true) {
        if (index < 0 || index >= albums.length) return;
        
        const track = albums[index];
        currentIndex = index;

        const trackSong = document.getElementById('track-song');
        const trackArtist = document.getElementById('track-artist');
        const trackMetaDetailEN = document.getElementById('track-meta-detail-en');
        const trackMetaDetailZH = document.getElementById('track-meta-detail-zh');
        const trackDescEN = document.getElementById('track-desc-en');
        const trackDescZH = document.getElementById('track-desc-zh');

        if (trackSong) {
          trackSong.textContent = track.song;
        }
        if (trackArtist) {
          trackArtist.textContent = track.artist;
        }
        if (trackMetaDetailEN) {
          trackMetaDetailEN.textContent = `${track.title} • ${track.year} • ${track.genreEN}`;
        }
        if (trackMetaDetailZH) {
          trackMetaDetailZH.textContent = `${track.title} • ${track.year} • ${track.genreZH}`;
        }
        if (trackDescEN) {
          trackDescEN.textContent = track.descEN;
        }
        if (trackDescZH) {
          trackDescZH.textContent = track.descZH;
        }

        // Update cover image on vinyl label
        if (track.cover) {
          vinylCover.src = track.cover;
          vinylCover.classList.add('is-loaded');
        } else {
          vinylCover.classList.remove('is-loaded');
          vinylCover.src = "";
        }

        // Set audio source
        audio.src = track.audioSrc;
        
        if (forcePlay && track.audioSrc) {
          // Swing tonearm first, then delay play slightly for realistic feel
          updatePlayerUI(true);
          setTimeout(() => {
            audio.play().catch((err) => {
              console.log("Audio play failed:", err);
              updatePlayerUI(false);
            });
          }, 600);
        } else {
          updatePlayerUI(false);
        }
      }

      // Play random track
      function playRandom() {
        if (albums.length === 0) return;
        
        let newIndex = currentIndex;
        // Avoid playing the same song twice if possible
        if (albums.length > 1) {
          while (newIndex === currentIndex) {
            newIndex = Math.floor(Math.random() * albums.length);
          }
        } else {
          newIndex = 0;
        }

        loadTrack(newIndex, true);
      }

      // Click vinyl record to shuffle/play next random song
      vinylRecord.addEventListener('click', (e) => {
        e.stopPropagation();
        playRandom();
      });

      // Click deck power button to toggle play/pause
      deckPowerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentIndex === -1) {
          // First play, pick random
          playRandom();
        } else {
          if (audio.paused) {
            updatePlayerUI(true);
            setTimeout(() => {
              audio.play().catch(() => updatePlayerUI(false));
            }, 600);
          } else {
            audio.pause();
            updatePlayerUI(false);
          }
        }
      });

      // Audio event listeners
      audio.addEventListener('play', () => {
        updatePlayerUI(true);
      });
      audio.addEventListener('pause', () => {
        updatePlayerUI(false);
      });
      audio.addEventListener('ended', () => {
        // Auto play next random song on end
        playRandom();
      });
    })();
  </script>
</Layout>
