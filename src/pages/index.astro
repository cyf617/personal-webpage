---
import Layout from "../layouts/Layout.astro";
import { content as c } from "../data/content";
const BASE = import.meta.env.BASE_URL;
const cvEN = `${BASE}/cv/Yifan_Chen_CV_EN.pdf`.replace(/\/+/g, "/");
const cvZH = `${BASE}/cv/Yifan_Chen_CV_ZH.pdf`.replace(/\/+/g, "/");
---

<Layout current="/">
  <section class="home">
    <!-- Header / Bio -->
    <div class="home-header">
      <div class="home-bio">
        <h1 class="home-name">
          <span class="lang-en">{c.home.en.name}</span>
          <span class="lang-zh">{c.home.zh.name}</span>
        </h1>
        <p class="home-title">
          <span class="lang-en">{c.home.en.title}</span>
          <span class="lang-zh">{c.home.zh.title}</span>
        </p>
        <p class="home-epigraph">
          <span class="lang-en">{c.home.en.tagline}</span>
          <span class="lang-zh">{c.home.zh.tagline}</span>
        </p>

        <div class="home-interests">
          {c.about.en.interests.map((_, i) => (
            <span class="home-interest-tag">
              <span class="lang-en">{c.about.en.interests[i]}</span>
              <span class="lang-zh">{c.about.zh.interests[i]}</span>
            </span>
          ))}
        </div>

        <div class="home-links">
          <a href={cvEN} target="_blank" class="home-link">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            <span class="lang-en">{c.home.en.downloadCV}</span>
            <span class="lang-zh">{c.home.zh.downloadCV}</span>
          </a>
          <a href={cvZH} target="_blank" class="home-link">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            <span class="lang-en">{c.home.en.downloadCVZh}</span>
            <span class="lang-zh">{c.home.zh.downloadCVZh}</span>
          </a>
          <a href={c.contact.en.github} target="_blank" rel="noopener" class="home-link">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.07 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.6.24 2.77.12 3.07.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
            GitHub
          </a>
        </div>
      </div>
      
      <div class="home-photo-container">
        <img src={`${BASE}/profile.jpg`.replace(/\/+/g, "/")} alt="Profile Picture" />
      </div>
    </div>

    <hr style="margin: 3rem 0; border: none; border-top: 1px solid var(--color-rule);" />

    <!-- About Me -->
    <div style="margin-bottom: 3rem;">
      <h2 class="section-title" style="margin-bottom: 1.5rem;">
        <span class="lang-en">{c.about.en.heading}</span>
        <span class="lang-zh">{c.about.zh.heading}</span>
      </h2>
      {c.about.en.body.map((_, i) => (
        <p class="about-bio">
          <span class="lang-en">{c.about.en.body[i]}</span>
          <span class="lang-zh">{c.about.zh.body[i]}</span>
        </p>
      ))}
    </div>

    <!-- Education -->
    <div style="margin-bottom: 3rem;">
      <h2 class="section-title" style="margin-bottom: 1.5rem;">
        <span class="lang-en">{c.education.en.heading}</span>
        <span class="lang-zh">{c.education.zh.heading}</span>
      </h2>
      <div class="education-list">
        {c.education.en.items.map((_, i) => {
          const en = c.education.en.items[i];
          const zh = c.education.zh.items[i];
          return (
            <div style="margin-bottom: 1.5rem;">
              <div style="display: flex; flex-direction: column; margin-bottom: 0.2rem;" class="sm:flex-row sm:justify-between sm:items-baseline">
                <h3 style="font-size: 1.15rem; font-weight: 600;">
                  <span class="lang-en">{en.school}</span>
                  <span class="lang-zh">{zh.school}</span>
                </h3>
                <span style="font-size: 0.95rem; color: var(--color-ink-muted);">
                  <span class="lang-en">{en.date}</span>
                  <span class="lang-zh">{zh.date}</span>
                </span>
              </div>
              <p style="font-style: italic; color: var(--color-ink-secondary); margin-bottom: 0.5rem;">
                <span class="lang-en">{en.degree} — {en.location}</span>
                <span class="lang-zh">{zh.degree} — {zh.location}</span>
              </p>
              {en.detail && en.detail.length > 0 && (
                <ul class="lang-en" style="list-style-type: disc; padding-left: 1.5rem; margin-top: 0.5rem;">
                  {en.detail.map((detail) => (
                    <li style="font-size: 0.95rem; color: var(--color-ink-secondary); margin-bottom: 0.25rem;">{detail}</li>
                  ))}
                </ul>
              )}
              {zh.detail && zh.detail.length > 0 && (
                <ul class="lang-zh" style="list-style-type: disc; padding-left: 1.5rem; margin-top: 0.5rem;">
                  {zh.detail.map((detail) => (
                    <li style="font-size: 0.95rem; color: var(--color-ink-secondary); margin-bottom: 0.25rem;">{detail}</li>
                  ))}
                </ul>
              )}
            </div>
          );
        })}
      </div>
    </div>

    <!-- Skills -->
    <div style="margin-bottom: 3rem;">
      <h2 class="section-title" style="margin-bottom: 1.5rem;">
        <span class="lang-en">{c.skills.en.heading}</span>
        <span class="lang-zh">{c.skills.zh.heading}</span>
      </h2>
      {c.skills.en.groups.map((_, i) => {
        const en = c.skills.en.groups[i];
        const zh = c.skills.zh.groups[i];
        return (
          <div class="skills-group" style="margin-bottom: 0.8rem;">
            <span class="skills-label" style="font-weight: 600; margin-right: 0.5rem;">
              <span class="lang-en">{en.label}:</span>
              <span class="lang-zh">{zh.label}:</span>
            </span>
            <span class="skills-items">
              <span class="lang-en">{en.items.join(", ")}</span>
              <span class="lang-zh">{zh.items.join(", ")}</span>
            </span>
          </div>
        );
      })}
    </div>

  </section>
</Layout>