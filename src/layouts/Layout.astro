---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const {
  title = "Yifan Chen · 陈奕帆",
  description = "Personal website of Yifan Chen — AI data analyst focused on complex transportation systems, trustworthy AI evaluation and sports AI applications.",
  current = "/",
} = Astro.props;
const BASE = import.meta.env.BASE_URL;
const faviconHref = `${BASE}/favicon.svg`.replace(/\/+/g, "/");
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f5" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Nav current={current} />
    <main class="page-enter">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function () {
        const saved = localStorage.getItem("lang");
        const initial = saved || (navigator.language?.toLowerCase().startsWith("zh") ? "zh" : "en");
        document.documentElement.setAttribute("data-lang", initial);
        document.documentElement.setAttribute("lang", initial === "zh" ? "zh-CN" : "en");
      })();

      window.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("[data-lang-toggle]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const cur = document.documentElement.getAttribute("data-lang") || "en";
            const next = cur === "en" ? "zh" : "en";
            document.documentElement.setAttribute("data-lang", next);
            document.documentElement.setAttribute("lang", next === "zh" ? "zh-CN" : "en");
            localStorage.setItem("lang", next);
          });
        });



        const toggle = document.getElementById("nav-mobile-toggle");
        const overlay = document.getElementById("nav-mobile-overlay");
        const panel = document.getElementById("nav-mobile-panel");
        if (toggle && overlay && panel) {
          const close = () => {
            overlay.classList.remove("is-open");
            panel.classList.remove("is-open");
          };
          toggle.addEventListener("click", () => {
            overlay.classList.toggle("is-open");
            panel.classList.toggle("is-open");
          });
          overlay.addEventListener("click", close);
          panel.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
        }
      });
    </script>
  </body>
</html>